# Server
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
DATA_DIR=./data
UPLOAD_DIR=./uploads
# Public URL used in notification links
APP_URL=http://localhost:3000

# Default admin created on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# WhatsApp (Meta WhatsApp Cloud API). Leave empty to log messages to console instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Optional approved template (required by Meta for messages outside the 24h window).
# Template must accept one body parameter: the message text.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Mobile push (Firebase Cloud Messaging HTTP v1). Leave empty to log to console instead.
# Path to the Firebase service-account JSON file.
FCM_SERVICE_ACCOUNT_FILE=

# Automatic follow-up
FOLLOWUP_INTERVAL_MINUTES=60
# Default days in a stage before a reminder is sent (each stage can override with sla_days)
FOLLOWUP_DEFAULT_DAYS=7
